[Unit]
Description=Video Library web viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=video-server
Group=video-server
WorkingDirectory=/opt/video-server
ExecStart=/opt/video-server/video-server
Restart=on-failure
RestartSec=3

Environment=PORT=5000
Environment=VIDEO_ROOT=/srv/videos
Environment=VIDEO_DB=/opt/video-server/videos.sqlite3
Environment=VIDEO_THUMB_DIR=/opt/video-server/thumbnails
Environment=APP_PASSWORD=change-me

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/video-server

[Install]
WantedBy=multi-user.target
